<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Email Verification</title>
  </head>

  <body
    style="
      margin: 0;
      padding: 0;
      background-color: #f4f7fb;
      font-family: Arial, Helvetica, sans-serif;
      color: #1f2937;
    "
  >
    <table
      width="100%"
      cellpadding="0"
      cellspacing="0"
      border="0"
      style="background-color: #f4f7fb; padding: 40px 15px"
    >
      <tr>
        <td align="center">
          <!-- Main Container -->
          <table
            width="100%"
            cellpadding="0"
            cellspacing="0"
            border="0"
            style="
              max-width: 600px;
              background-color: #ffffff;
              border-radius: 12px;
              overflow: hidden;
              box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
            "
          >
            <!-- Header -->
            <tr>
              <td
                align="center"
                style="background-color: #2563eb; padding: 30px 20px"
              >
                <h1
                  style="
                    margin: 0;
                    color: #ffffff;
                    font-size: 26px;
                    font-weight: 700;
                  "
                >
                  Email Verification
                </h1>

                <p style="margin: 8px 0 0; color: #dbeafe; font-size: 14px">
                  Confirm your email address to get started
                </p>
              </td>
            </tr>

            <!-- Content -->
            <tr>
              <td style="padding: 40px 35px">
                <p style="margin: 0 0 18px; font-size: 16px; line-height: 1.6">
                  Hello <strong><%= name %></strong>,
                  <p>Your Email is <%= email%></p>
                </p>

                <p
                  style="
                    margin: 0 0 25px;
                    font-size: 15px;
                    line-height: 1.7;
                    color: #4b5563;
                  "
                >
                  Thank you for signing up! Please use the verification code below to verify your email address and complete your registration.
                </p>

                <!-- OTP Box -->
                <table
                  width="100%"
                  cellpadding="0"
                  cellspacing="0"
                  border="0"
                  style="
                    background-color: #eff6ff;
                    border: 1px solid #bfdbfe;
                    border-radius: 10px;
                  "
                >
                  <tr>
                    <td align="center" style="padding: 25px 15px">
                      <p
                        style="
                          margin: 0 0 10px;
                          font-size: 13px;
                          color: #6b7280;
                          text-transform: uppercase;
                          letter-spacing: 1px;
                          font-weight: 600;
                        "
                      >
                        Your verification code
                      </p>

                      <div
                        style="
                          font-size: 36px;
                          font-weight: 700;
                          letter-spacing: 8px;
                          color: #2563eb;
                        "
                      >
                        <%= otpValue %>
                      </div>
                    </td>
                  </tr>
                </table>

                <!-- Expiration -->
                <p
                  style="
                    margin: 25px 0 0;
                    text-align: center;
                    font-size: 14px;
                    color: #6b7280;
                  "
                >
                  This code will expire in
                  <strong><%= expirationMinutes %> minutes</strong>.
                </p>

                <!-- Security Notice -->
                <table
                  width="100%"
                  cellpadding="0"
                  cellspacing="0"
                  border="0"
                  style="
                    margin-top: 30px;
                    background-color: #fff7ed;
                    border-left: 4px solid #f97316;
                  "
                >
                  <tr>
                    <td style="padding: 14px 16px">
                      <p
                        style="
                          margin: 0;
                          font-size: 13px;
                          line-height: 1.6;
                          color: #9a3412;
                        "
                      >
                        <strong>Security notice:</strong>
                        If you didn't create an account with us, please ignore this email. Never share this code with anyone.
                      </p>
                    </td>
                  </tr>
                </table>

                <p
                  style="
                    margin: 30px 0 0;
                    font-size: 14px;
                    line-height: 1.6;
                    color: #6b7280;
                  "
                >
                  Thanks,<br />
                  <strong>Your Support Team</strong>
                </p>
              </td>
            </tr>

            <!-- Footer -->
            <tr>
              <td
                align="center"
                style="
                  background-color: #f9fafb;
                  border-top: 1px solid #e5e7eb;
                  padding: 20px;
                "
              >
                <p
                  style="
                    margin: 0;
                    font-size: 12px;
                    color: #9ca3af;
                    line-height: 1.5;
                  "
                >
                  This is an automated email. Please do not reply to this message.
                </p>

                <p style="margin: 8px 0 0; font-size: 12px; color: #9ca3af">
                  © <%= new Date().getFullYear() %> All rights reserved.
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>