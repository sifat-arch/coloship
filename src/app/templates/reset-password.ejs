<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Password Reset Successful</title>
  </head>

  <body
    style="
      margin: 0;
      padding: 0;
      background-color: #f4f7fb;
      font-family: Arial, Helvetica, sans-serif;
      color: #1f2937;
    "
  >
    <table
      width="100%"
      cellpadding="0"
      cellspacing="0"
      border="0"
      style="background-color: #f4f7fb; padding: 40px 15px"
    >
      <tr>
        <td align="center">
          <table
            width="100%"
            cellpadding="0"
            cellspacing="0"
            border="0"
            style="
              max-width: 600px;
              background-color: #ffffff;
              border-radius: 12px;
              overflow: hidden;
              box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
            "
          >
            <!-- Header -->
            <tr>
              <td
                align="center"
                style="background-color: #16a34a; padding: 30px 20px"
              >
                <h1
                  style="
                    margin: 0;
                    color: #ffffff;
                    font-size: 24px;
                    font-weight: 700;
                  "
                >
                  Password Reset Successful
                </h1>
                <p style="margin: 8px 0 0; color: #dcfce7; font-size: 14px">
                  Your account security has been updated
                </p>
              </td>
            </tr>

            <!-- Content -->
            <tr>
              <td style="padding: 40px 35px">
                <p style="margin: 0 0 18px; font-size: 16px; line-height: 1.6">
                  Hello <strong><%= name %></strong>,
                </p>

                <p style="margin: 0 0 18px; font-size: 15px; color: #4b5563">
                  Your password for <strong><%= email %></strong> was
                  successfully changed. You can now use your new password to log
                  in to Coloship.
                </p>

                <!-- Security Notice -->
                <table
                  width="100%"
                  cellpadding="0"
                  cellspacing="0"
                  border="0"
                  style="
                    margin-top: 25px;
                    background-color: #fff7ed;
                    border-left: 4px solid #f97316;
                  "
                >
                  <tr>
                    <td style="padding: 14px 16px">
                      <p
                        style="
                          margin: 0;
                          font-size: 13px;
                          line-height: 1.6;
                          color: #9a3412;
                        "
                      >
                        <strong>Security Alert:</strong>
                        If you did not perform this action, please contact our
                        support team immediately to secure your account.
                      </p>
                    </td>
                  </tr>
                </table>

                <p
                  style="
                    margin: 30px 0 0;
                    font-size: 14px;
                    line-height: 1.6;
                    color: #6b7280;
                  "
                >
                  Best regards,<br />
                  <strong>Coloship Team</strong>
                </p>
              </td>
            </tr>

            <!-- Footer -->
            <tr>
              <td
                align="center"
                style="
                  background-color: #f9fafb;
                  border-top: 1px solid #e5e7eb;
                  padding: 20px;
                "
              >
                <p
                  style="
                    margin: 0;
                    font-size: 12px;
                    color: #9ca3af;
                    line-height: 1.5;
                  "
                >
                  This is an automated security email. Please do not reply.
                </p>
                <p style="margin: 8px 0 0; font-size: 12px; color: #9ca3af">
                  © <%= new Date().getFullYear() %> Coloship. All rights
                  reserved.
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
