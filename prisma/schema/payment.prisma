model Payment {
  id String @id @default(uuid())

  // Shipment Relation (Appointment-এর পরিবর্তে Shipment)
  shipmentId String   @unique
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  status PaymentStatus @default(UNPAID)
  method PaymentMethod @default(BKASH)

  amount   Decimal @db.Decimal(10, 2)
  currency String  @default("BDT")

  paymentGateway        String  @default("bkash")
  merchantInvoiceNumber String  @unique // shipment id
  paymentUrl            String?

  bkashPaymentId String? @unique
  bkashTrxId     String? @unique // bakshTrxId টাইপো সংশোধন করা হয়েছে
  payerReference String? // customer email / phone
  paidAt         String?

  gatewayResponse Json?

  refundTrxId  String?
  refundAmount Decimal? @db.Decimal(10, 2)
  refundReason String?
  refundedAt   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([bkashTrxId])
  @@map("payments")
}